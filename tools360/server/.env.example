# Copy this file to .env and fill in real values. Never commit .env.
PORT=3000
NODE_ENV=development
# Postgres connection string (Supabase, Render, Neon or local)
DATABASE_URL=postgresql://user:password@localhost:5432/tools360
# Comma-separated list of sites allowed to call this API
ALLOWED_ORIGINS=http://localhost:5500,https://your-domain.com
# Secret used to read GET /api/stats/summary
ADMIN_KEY=change-me-to-a-long-random-string
